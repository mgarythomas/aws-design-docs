---
title: "Instrument reference data model: all columns"
---
erDiagram
    admission_tier |o..o{ listing_status : "governing_framework, admission_tier"
    basket ||--o{ basket_component : "basket_id"
    basket |o--o| typed_ref : "basket_id"
    derivative_instrument ||--o{ derivative_terms_version : "instrument_id, instrument_class"
    derivative_instrument ||--o{ underlying_link : "instrument_id"
    derivative_product ||--o{ contract_specification_version : "product_id"
    derivative_product ||--o{ derivative_series : "product_id"
    derivative_series ||--o{ derivative_instrument : "series_id"
    eligibility_basis |o..o{ basket_component : "eligibility_basis"
    etf |o--o{ basket : "etf_instrument_id"
    etf ||--o{ etf_version : "instrument_id"
    governing_framework ||..o{ admission_tier : "governing_framework"
    governing_framework ||..o{ instrument_version : "governing_framework"
    governing_framework ||..o{ status_code : "governing_framework"
    identifier_scheme ||..o{ instrument_identifier : "scheme"
    instrument ||--o| derivative_instrument : "instrument_id, instrument_class"
    instrument ||--o| etf : "instrument_id, instrument_class"
    instrument ||--o{ instrument_identifier : "instrument_id"
    instrument ||--o{ instrument_version : "instrument_id"
    instrument ||--o{ listing : "instrument_id"
    instrument |o--o| typed_ref : "instrument_id"
    listing ||--o{ listing_status : "listing_id"
    listing ||--o{ listing_version : "listing_id"
    obligation_ref |o..o{ eligibility_basis : "obligation_ref_id"
    obligation_ref |o..o{ listing_status : "authority_ref_id"
    reference_index |o--o{ basket : "index_id"
    reference_index |o--o{ etf_version : "benchmark_index_id"
    reference_index ||--o{ reference_index_version : "index_id"
    reference_index |o--o| typed_ref : "index_id"
    status_code ||..o{ listing_status : "governing_framework, status_code"
    typed_ref ||--o{ basket_component : "typed_ref_id"
    typed_ref ||--o{ underlying_link : "typed_ref_id"
    basket {
        uuid basket_id PK
        text owner_type
        uuid etf_instrument_id FK "optional"
        uuid index_id FK "optional"
        uuid owner_key "generated"
        text basket_type
        date business_date
        integer version_no
        text status
        timestamptz received_at
        timestamptz published_at "optional"
        timestamptz recorded_at
        timestamptz superseded_at "optional"
        numeric cash_amount "optional"
        currency_code cash_currency "optional"
        numeric creation_unit_size "optional"
        integer declared_line_count "optional"
        text source_system
        text source_reference "optional"
        uuid fulfilment_id "optional"
    }
    basket_component {
        uuid basket_id PK, FK
        date business_date PK
        integer line_no PK
        uuid typed_ref_id FK
        numeric quantity "optional"
        numeric weight "optional"
        text direction
        currency_code component_currency "optional"
        text eligibility_basis FK "optional"
    }
    contract_specification_version {
        uuid spec_version_id PK
        uuid product_id FK
        daterange valid_range
        tstzrange recorded_range
        numeric price_multiplier
        text delivery_type
        text exercise_style "optional"
        text expiry_cycle "optional"
        numeric tick_size "optional"
        numeric tick_value "optional"
        text settlement_method "optional"
        text source_system
        text recorded_by
        text approval_status
        text approved_by "optional"
    }
    derivative_instrument {
        uuid instrument_id PK, FK
        text instrument_class FK
        uuid series_id FK
    }
    derivative_product {
        uuid product_id PK
        mic_code mic
        text product_code
        text product_type
        text name
    }
    derivative_series {
        uuid series_id PK
        uuid product_id FK
        text series_period
    }
    derivative_terms_version {
        uuid terms_version_id PK
        uuid instrument_id FK
        text instrument_class FK
        daterange valid_range
        tstzrange recorded_range
        date expiry_date
        numeric price_multiplier
        text delivery_type
        text option_type "optional"
        text exercise_style "optional"
        numeric strike_price "optional"
        currency_code strike_currency "optional"
        boolean adjusted_flag
        boolean non_standard_flag
        text source_system
        text recorded_by
        text approval_status
        text approved_by "optional"
    }
    etf {
        uuid instrument_id PK, FK
        text instrument_class FK
    }
    etf_version {
        uuid etf_version_id PK
        uuid instrument_id FK
        daterange valid_range
        tstzrange recorded_range
        text aqua_product_type
        text replication_method "optional"
        numeric ter_percent "optional"
        text distribution_policy "optional"
        numeric creation_unit_size "optional"
        numeric leverage_factor "optional"
        boolean currency_hedged "optional"
        country_code domicile "optional"
        uuid benchmark_index_id FK "optional"
        boolean uses_otc_derivatives "optional"
        text source_system
        text recorded_by
        text approval_status
        text approved_by "optional"
    }
    instrument {
        uuid instrument_id PK
        text instrument_class
        timestamptz created_at
    }
    instrument_identifier {
        uuid identifier_id PK
        uuid instrument_id FK
        text scheme FK
        text id_value
        daterange valid_range
        tstzrange recorded_range
        text source_system
    }
    instrument_version {
        uuid instrument_version_id PK
        uuid instrument_id FK
        daterange valid_range
        tstzrange recorded_range
        cfi_code cfi_code "optional"
        text fisn "optional"
        text full_name
        currency_code denomination_currency
        lei_code issuer_lei "optional"
        text governing_framework FK
        text lifecycle_status
        jsonb ext
        text source_system
        text recorded_by
        text approval_status
        text approved_by "optional"
    }
    listing {
        uuid listing_id PK
        uuid instrument_id FK
        mic_code mic
        timestamptz created_at
    }
    listing_status {
        uuid listing_status_id PK
        uuid listing_id FK
        text governing_framework FK
        text status_code FK
        text admission_tier FK "optional"
        text reason "optional"
        uuid authority_ref_id FK "optional"
        daterange valid_range
        tstzrange recorded_range
        text source_system
        text recorded_by
        text approval_status
        text approved_by "optional"
    }
    listing_version {
        uuid listing_version_id PK
        uuid listing_id FK
        daterange valid_range
        tstzrange recorded_range
        text local_symbol
        currency_code trading_currency
        text tick_size_regime "optional"
        numeric lot_size "optional"
        text source_system
    }
    reference_index {
        uuid index_id PK
        text index_code UK
        text name
        text administrator "optional"
        currency_code base_currency "optional"
        timestamptz created_at
    }
    reference_index_version {
        uuid index_version_id PK
        uuid index_id FK
        daterange valid_range
        tstzrange recorded_range
        boolean level_publicly_available "optional"
        text methodology_ref "optional"
        text methodology_version "optional"
        text governance_ref "optional"
        text source_system
        text recorded_by
        text approval_status
        text approved_by "optional"
    }
    typed_ref {
        uuid typed_ref_id PK
        uuid instrument_id FK, UK "optional"
        uuid index_id FK, UK "optional"
        uuid basket_id FK, UK "optional"
        currency_code cash_currency UK "optional"
        text commodity_code UK "optional"
        text rate_code UK "optional"
        text ref_type "generated"
    }
    underlying_link {
        uuid underlying_link_id PK
        uuid instrument_id FK
        uuid typed_ref_id FK
        numeric weight
        daterange valid_range
        tstzrange recorded_range
        text source_system
    }
    admission_tier {
        text governing_framework PK, FK
        text tier_code PK
        text description "optional"
    }
    eligibility_basis {
        text eligibility_basis PK
        text description
        uuid obligation_ref_id FK "optional"
    }
    governing_framework {
        text governing_framework PK
        text description
    }
    identifier_scheme {
        text scheme PK
        text description
        text value_pattern "optional"
    }
    obligation_ref {
        uuid obligation_ref_id PK
        text rulebook
        text rule_number
        text rule_version
        daterange effective_range
        text description "optional"
        text source_url "optional"
    }
    status_code {
        text governing_framework PK, FK
        text status_code PK
        boolean is_terminal
        text description "optional"
    }
