    entity_address {
        uuid address_id PK
        uuid entity_id FK
    }
    entity_identifier {
        uuid identifier_id PK
        uuid entity_id FK
        text scheme FK
    }
    entity_name {
        uuid entity_name_id PK
        uuid entity_id FK
    }
