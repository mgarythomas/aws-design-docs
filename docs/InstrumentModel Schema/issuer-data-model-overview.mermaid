        text role_type FK
    }
    person {
        uuid person_id PK
    }
    instrument_issuer {
        uuid instrument_issuer_id PK
        uuid instrument_id FK
        uuid issuer_id FK
        text party_role FK
    }
    issuer {
        uuid issuer_id PK
        uuid entity_id FK, UK
    }
    issuer_classification {
        uuid classification_id PK
        uuid issuer_id FK
        text scheme FK
    }
    issuer_status {
        uuid issuer_status_id PK
